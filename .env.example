# Local preview is not indexable. Set a real production domain before enabling SEO.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_INDEXABLE=false
# After public deployment, use the verification values supplied by each account.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Omit JARVIS_RELEASE_PUBLISHED to use the prepared local beta artifact.
# Set false to disable downloads; true selects the complete HTTPS release below.
# JARVIS_RELEASE_PUBLISHED=false
JARVIS_DOWNLOAD_URL=
JARVIS_DOWNLOAD_HOSTS=github.com,objects.githubusercontent.com
JARVIS_VERSION=
JARVIS_SHA256=
JARVIS_SIZE_BYTES=
JARVIS_PUBLISHED_AT=
JARVIS_PUBLISHER=
JARVIS_PLATFORM=
